{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "tests/**/*.ts",
    "fixtures/**/*.ts",
    "utils/**/*.ts",
    "pages/**/*.ts",
    "schemas/**/*.ts",
    "types/**/*.ts",
    "api/**/*.ts",
    "playwright.config.ts"
  ]
}
